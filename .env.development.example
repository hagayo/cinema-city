APP_ENV=development
API_MODE=combined
MEDIA_STORAGE=local

# Authentication enabled
AUTH_ENABLED=true
AUTH_PROVIDER=clerk

# Neon DB Storage enabled
STORAGE_BACKEND=neon
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_GIVEN_URL

# Enable only after all three sandbox credentials/IDs are populated.
BILLING_PROVIDER=disabled
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_TEST_PRICE_ID=
# Reserved for the later webhook integration, not required for this smoke test.
PADDLE_WEBHOOK_SECRET=
